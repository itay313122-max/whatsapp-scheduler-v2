rules_version = '2';

// Stages 1–2 rules: users, inviteCodes, groups (+ read gates for turns/clips/
// reactions honoring the members-only privacy principle).
// Stage 5 finalizes write rules for clips/reactions and locks turn lifecycle
// writes to Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── users ────────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (to show member names); you may
    // only create/update your own document.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── inviteCodes ──────────────────────────────────────────────────────
    // Lookup docs (code -> groupId) so a not-yet-member can resolve a code.
    // No sensitive content. Create-if-absent gives atomic uniqueness.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/inviteCodes/$(code));
      allow update, delete: if false;
    }

    // ── groups ───────────────────────────────────────────────────────────
    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }
      // Joining yourself: you're being added to memberIds but weren't there
      // before. (Field-level tightening — e.g. disallow touching currentTurn —
      // comes in Stage 5.)
      function isJoiningSelf() {
        return signedIn()
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds);
      }

      allow read: if isMember();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember() || isJoiningSelf();
      allow delete: if false;

      match /turns/{turnId} {
        function groupData() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }
        function isGroupMember() {
          return signedIn() && request.auth.uid in groupData().memberIds;
        }

        allow read: if isGroupMember();
        // TEMP (Stage 3): a member may create their own turn for testing.
        // Stage 5 removes this — turn creation moves to the selectDailyVlogger
        // Cloud Function so the daily pick can't be forged from the client.
        allow create: if isGroupMember()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false; // expiry handled server-side (Stage 5)

        match /clips/{clipId} {
          allow read: if isGroupMember();
          // A member uploads their own clip (uploaderId must be them).
          allow create: if isGroupMember()
            && request.resource.data.uploaderId == request.auth.uid;
          allow update, delete: if false;

          match /reactions/{reactionId} {
            allow read: if isGroupMember();
            // A member reacts as themselves.
            allow create: if isGroupMember()
              && request.resource.data.userId == request.auth.uid;
            allow update, delete: if false;
          }
        }
      }
    }
  }
}
