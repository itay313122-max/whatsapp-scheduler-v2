# Copy this file to `.env` and fill in your Firebase web-app config.
# You get these values from Firebase Console → Project Settings → Your apps → Web app.
# The EXPO_PUBLIC_ prefix is required so Expo exposes them to the app at runtime.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
