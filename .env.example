# ── הגדרות העוזר האישי — העתק קובץ זה ל- .env ומלא ──

# איזה מנוע AI: gemini (חינמי, מומלץ) או claude (איכות מקסימלית, בתשלום)
LLM_PROVIDER=gemini

# מפתח Gemini — חינמי! השג ב- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# מפתח Claude — בתשלום, אופציונלי. https://console.anthropic.com
ANTHROPIC_API_KEY=

# קוד גישה פרטי (מומלץ). אם תמלא — יידרש הקוד הזה כדי להיכנס לעוזר.
APP_PASSWORD=

# פורט (אופציונלי)
PORT=3000
